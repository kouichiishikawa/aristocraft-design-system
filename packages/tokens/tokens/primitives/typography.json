{
  "typography": {
    "family": {
      "$description": "すべて OFL（無料）。費用上限 月 3,000 円に適合",
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "Inter Variable",
          "Inter",
          "system-ui",
          "sans-serif"
        ],
        "$description": "欧文の本文・見出し・UI。可変フォント（opsz 軸あり）"
      },
      "serif": {
        "$type": "fontFamily",
        "$value": [
          "Lora",
          "Georgia",
          "serif"
        ],
        "$description": "欧文の引用・見出しの対比用。可変フォント"
      },
      "jp": {
        "$type": "fontFamily",
        "$value": [
          "Noto Sans JP",
          "Hiragino Sans",
          "Yu Gothic",
          "sans-serif"
        ],
        "$description": "和文。サブセット配信（Google Fonts の unicode-range）を前提"
      },
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "Geist Mono",
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "monospace"
        ],
        "$description": "数値・コード・トークン名"
      }
    },
    "size": {
      "$description": "4px = 100。Major Third（1.25）を基準 16px から展開し、4px の倍数に丸め、頻用の 14 / 18 / 28 を追加。最小 10、最大 128",
      "250": {
        "$type": "dimension",
        "$value": {
          "value": 10,
          "unit": "px"
        },
        "$description": "Major Third の下限（16 ÷ 1.25² = 10.24 → 10）"
      },
      "300": {
        "$type": "dimension",
        "$value": {
          "value": 12,
          "unit": "px"
        },
        "$description": "16 ÷ 1.25 = 12.8 → 12（頻用）"
      },
      "350": {
        "$type": "dimension",
        "$value": {
          "value": 14,
          "unit": "px"
        },
        "$description": "頻用のため追加（スケール外）"
      },
      "400": {
        "$type": "dimension",
        "$value": {
          "value": 16,
          "unit": "px"
        },
        "$description": "基準"
      },
      "450": {
        "$type": "dimension",
        "$value": {
          "value": 18,
          "unit": "px"
        },
        "$description": "頻用のため追加（スケール外）"
      },
      "500": {
        "$type": "dimension",
        "$value": {
          "value": 20,
          "unit": "px"
        },
        "$description": "16 × 1.25"
      },
      "600": {
        "$type": "dimension",
        "$value": {
          "value": 24,
          "unit": "px"
        },
        "$description": "16 × 1.25² = 25 → 24（頻用）"
      },
      "700": {
        "$type": "dimension",
        "$value": {
          "value": 28,
          "unit": "px"
        },
        "$description": "頻用のため追加（スケール外）"
      },
      "800": {
        "$type": "dimension",
        "$value": {
          "value": 32,
          "unit": "px"
        },
        "$description": "16 × 1.25³ = 31.25 → 32"
      },
      "1000": {
        "$type": "dimension",
        "$value": {
          "value": 40,
          "unit": "px"
        },
        "$description": "16 × 1.25⁴ = 39.1 → 40"
      },
      "1200": {
        "$type": "dimension",
        "$value": {
          "value": 48,
          "unit": "px"
        },
        "$description": "16 × 1.25⁵ = 48.8 → 48"
      },
      "1600": {
        "$type": "dimension",
        "$value": {
          "value": 64,
          "unit": "px"
        },
        "$description": "16 × 1.25⁶ = 61 → 64"
      },
      "2000": {
        "$type": "dimension",
        "$value": {
          "value": 80,
          "unit": "px"
        },
        "$description": "16 × 1.25⁷ = 76.3 → 80"
      },
      "2400": {
        "$type": "dimension",
        "$value": {
          "value": 96,
          "unit": "px"
        },
        "$description": "16 × 1.25⁸ = 95.4 → 96"
      },
      "3200": {
        "$type": "dimension",
        "$value": {
          "value": 128,
          "unit": "px"
        },
        "$description": "16 × 1.25⁹ = 119 → 128（上限）"
      }
    },
    "lineHeight": {
      "$description": "倍率 5 段（GitHub Primer 参照）。semantic では size × 倍率の line box を確認し、4px の倍数になる px 値で確定する",
      "sm": {
        "$type": "number",
        "$value": 1.25,
        "$description": "見出し・大きな数字"
      },
      "md": {
        "$type": "number",
        "$value": 1.375,
        "$description": "小見出し・UI ラベル"
      },
      "lg": {
        "$type": "number",
        "$value": 1.5,
        "$description": "本文の基準"
      },
      "xl": {
        "$type": "number",
        "$value": 1.625,
        "$description": "和文本文・読み物"
      },
      "xxl": {
        "$type": "number",
        "$value": 1.75,
        "$description": "和文の長文・ゆったりした本文"
      }
    },
    "letterSpacing": {
      "$description": "em。3 段",
      "sm": {
        "$type": "dimension",
        "$value": {
          "value": -0.02,
          "unit": "em"
        },
        "$description": "見出し・大きな数字を締める"
      },
      "md": {
        "$type": "dimension",
        "$value": {
          "value": 0,
          "unit": "em"
        },
        "$description": "既定"
      },
      "lg": {
        "$type": "dimension",
        "$value": {
          "value": 0.02,
          "unit": "em"
        },
        "$description": "小さいラベル・大文字を開く"
      }
    },
    "weight": {
      "$description": "4 段。Inter Variable / Noto Sans JP / Lora / Geist Mono すべてで利用可",
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700
      }
    }
  }
}