---
// Static page; the buttons are React islands hydrated on load.
import '@aristocraft/tokens/css';
import '@aristocraft/ui/styles.css';
import { Button } from '@aristocraft/ui';
import { ThemeToggle } from '../components/ThemeToggle';
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>aristocraft ui × Astro</title>
  </head>
  <body>
    <main class="page">
      <h1 class="title">aristocraft ui × Astro 7</h1>
      <p class="lead">Button from @aristocraft/ui as React islands, tokens from @aristocraft/tokens.</p>
      <div class="row">
        <Button client:load>Primary</Button>
        <Button client:load variant="secondary">Secondary</Button>
        <Button client:load variant="ghost">Ghost</Button>
      </div>
      <div class="row">
        <Button client:load size="sm">Small</Button>
        <Button client:load size="md">Medium</Button>
        <Button client:load size="lg">Large</Button>
        <Button client:load disabled>Disabled</Button>
      </div>
      <ThemeToggle client:load />
    </main>
  </body>
</html>

<style is:global>
  html {
    background: var(--ac-elevation-surface-default);
    color: var(--ac-color-text-default);
    font-family: var(--ac-font-body-md-font-family);
    font-size: var(--ac-font-body-md-font-size);
    line-height: var(--ac-font-body-md-line-height);
    -webkit-font-smoothing: antialiased;
  }
  body { margin: 0; }
  .page {
    max-width: var(--ac-layout-container-prose);
    margin-inline: auto;
    padding: var(--ac-layout-section-md) var(--ac-layout-grid-margin-xs);
    display: grid;
    gap: var(--ac-dimension-space-600);
  }
  .title {
    margin: 0;
    font-size: var(--ac-font-heading-xl-font-size);
    line-height: var(--ac-font-heading-xl-line-height);
    font-weight: var(--ac-font-heading-xl-font-weight);
    letter-spacing: var(--ac-font-heading-xl-letter-spacing);
  }
  .lead { margin: 0; color: var(--ac-color-text-subtle); }
  .row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--ac-dimension-space-400); }
</style>
